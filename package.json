{
  "name": "meme-yizhan",
  "version": "3.5.0",
  "private": true,
  "description": "MEME·译站 / MemeBridge —— 中国梗的跨文化转译平台",
  "scripts": {
    "validate": "node scripts/validate-content.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o css/tailwind.css --watch",
    "build:og": "node scripts/build-og.mjs",
    "build:memes": "node scripts/build-memes.mjs",
    "build": "npm run validate && npm run build:data && npm run build:css && npm run build:og && npm run build:memes",
    "build:deploy": "npm run validate && npm run build:data && npm run build:css && npm run build:og && npm run build:memes",
    "smoke": "node tests/i18n-smoke.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "js-yaml": "^5.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^3.4.17"
  }
}
